[gd_scene load_steps=2 format=3 uid="uid://lobby_scene"]

[ext_resource type="Script" path="res://scripts/ui/lobby_screen.gd" id="1_lobby"]

[node name="LobbyScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_lobby")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -250.0
offset_top = -280.0
offset_right = 250.0
offset_bottom = 280.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="TitleLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.75, 0.55, 1)
theme_override_font_sizes/font_size = 36
text = "ONLINE BATTLE"
horizontal_alignment = 1

[node name="Sep1" type="HSeparator" parent="VBoxContainer"]
layout_mode = 2

[node name="ServerLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.55, 0.5, 1)
theme_override_font_sizes/font_size = 14
text = "Server Address"

[node name="ServerContainer" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2

[node name="ServerInput" type="LineEdit" parent="VBoxContainer/ServerContainer"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "ws://localhost:8080"
theme_override_font_sizes/font_size = 16

[node name="CreateButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 50)
theme_override_font_sizes/font_size = 22
text = "⚔  CREATE LOBBY"

[node name="OrLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.45, 0.4, 1)
theme_override_font_sizes/font_size = 18
text = "— OR —"
horizontal_alignment = 1

[node name="JoinContainer" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="CodeInput" type="LineEdit" parent="VBoxContainer/JoinContainer"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 50)
placeholder_text = "Enter lobby code..."
theme_override_font_sizes/font_size = 20
max_length = 6
caret_blink = true

[node name="JoinButton" type="Button" parent="VBoxContainer/JoinContainer"]
layout_mode = 2
custom_minimum_size = Vector2(120, 50)
theme_override_font_sizes/font_size = 20
text = "JOIN"

[node name="Sep2" type="HSeparator" parent="VBoxContainer"]
layout_mode = 2

[node name="LobbyCodeLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.9, 0.3, 1)
theme_override_font_sizes/font_size = 28
text = "LOBBY CODE: ABC123"
horizontal_alignment = 1

[node name="WaitingLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.65, 0.6, 1)
theme_override_font_sizes/font_size = 16
text = "Waiting for opponent..."
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.65, 0.6, 1)
theme_override_font_sizes/font_size = 16
text = ""
horizontal_alignment = 1
autowrap_mode = 2

[node name="BackButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
theme_override_font_sizes/font_size = 18
text = "← BACK TO MENU"
